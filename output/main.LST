  73          /**
  74           * @brief  处理按键事件
  75           * @param  event: 按键事件类型（长按/短按）
  76           * @note   事件处理逻辑：
  77           *         - 长按：开关机切换
  78           *           → 开机时：设为IDLE模式 + 振动50ms确认 + LED常亮
  79           *           → 关机时：关闭马达+LED + 进入STOP模式待机
  80           *         - 短按：切换振动模式（仅在开机状态下有效）
  81           *           → 循环切换10种模式
  82           *           → LED闪烁500ms提示
  83           *           → 重置空闲计时器
  84           */
  85          static void Handle_ButtonEvent(Button_Event_t event)
  86          {
  87   1          static u8 s_startup_vibration_done = 0;
  88   1          Motor_Mode_t current_mode;
  89   1          Motor_Mode_t next_mode;
  90   1          
  91   1          if (event == BUTTON_EVENT_NONE)
  92   1          {
  93   2              return;
  94   2          }
  95   1          
  96   1          switch (event)
  97   1          {
  98   2              case BUTTON_EVENT_LONG_PRESS:
  99   2                  switch (Power_GetState())
 100   2                  {
 101   3                      case POWER_STATE_ON:
 102   3                          Power_SetState(POWER_STATE_OFF);
 103   3                          LED_SetState(LED_STATE_OFF);
 104   3                          Motor_Control(0);
 105   3                          Motor_SetMode(MOTOR_MODE_IDLE);
 106   3                          s_startup_vibration_done = 0;
 107   3                          break;
 108   3                          
 109   3                      default:
 110   3                          Power_SetState(POWER_STATE_ON);
 111   3                          Motor_SetMode(MOTOR_MODE_IDLE);
 112   3                          LED_SetState(LED_STATE_ON);
 113   3                          
 114   3                          Motor_Control(1);
 115   3                          s_1ms_tick = 0;
 116   3                          while (s_1ms_tick < STARTUP_VIBRATION_MS)
 117   3                          {
C51 COMPILER V7.00  MAIN                                                                   09/29/2026 07:47:58 PAGE 3   

 118   4                              ;
 119   4                          }
 120   3                          Motor_Control(0);
 121   3                          
 122   3                          s_startup_vibration_done = 1;
 123   3                          break;
 124   3                  }
 125   2                  break;
 126   2                  
 127   2              case BUTTON_EVENT_SHORT_PRESS:
 128   2                  if (Power_GetState() == POWER_STATE_ON)
 129   2                  {
 130   3                      current_mode = Motor_GetMode();
 131   3                      next_mode = (Motor_Mode_t)((current_mode + 1) % MOTOR_MODE_COUNT);
 132   3                      Motor_SetMode(next_mode);
 133   3                      LED_StartBlink500ms();
 134   3                      Power_ResetIdleCounter();
 135   3                  }
 136   2                  break;
 137   2                  
 138   2              default:
 139   2                  break;
 140   2          }
 141   1      }
