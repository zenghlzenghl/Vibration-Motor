  16          /**
  17           * @brief  Timer0初始化 - 1ms定时中断
  18           * @note   使用模式1（16位定时器）
  19           *         定时器重载值由F_CPU自动计算
  20           */
  21          static void Timer0_Init(void)
  22          {
  23   1          TMOD &= 0xF0;
  24   1          TMOD |= 0x01;
  25   1          TH0 = TIMER0_RELOAD_H;
  26   1          TL0 = TIMER0_RELOAD_L;
  27   1          ET0 = 1;
  28   1          TR0 = 1;
  29   1      }
  30          
  31          /**
  32           * @brief  Timer0中断服务程序 - 系统时钟基准
  33           * @note   每1ms执行一次（由硬件定时器精确保证）
  34           *         功能：
  35           *         - 更新系统1ms计时器
  36           *         - 设置1ms调度标志位（供主循环使用）
  37           *         - 更新空闲计时器（用于自动关机判断）
  38           */
  39          void Timer0_ISR(void) interrupt 1
  40          {
  41   1          TH0 = TIMER0_RELOAD_H;
  42   1          TL0 = TIMER0_RELOAD_L;
  43   1          
  44   1          s_1ms_tick++;
  45   1          s_1ms_flag = 1;
  46   1          
  47   1          if (Power_GetState() == POWER_STATE_ON)
  48   1          {
  49   2              Power_IncrementIdleCounter();
  50   2          }
  51   1      }
  52          
  53          /**
