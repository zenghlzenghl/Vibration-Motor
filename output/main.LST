 189          /**
 190           * @brief  主函数 - 无限循环（基于1ms精确调度）
 191           * @note   主循环结构：
 192           *         ┌──────────────────────────────�
             -�─────────────┐
 193           *         │ while(1) {                                 │
 194           *         │   if (POWER_OFF) {                         │
 195           *         │     EnterStopMode(); // 低功耗等待唤醒      │
 196           *         │     处理唤醒事件;                           │
 197           *         │   } else if (1ms标志) {                    │
 198           *         │     清除1ms标志;                           │
 199           *         │     Button_Poll();   // 严格1ms轮询         │
 200           *         │     Power_Poll();    // 严格1ms轮询         │
 201           *         │     Motor_Poll();    // 严格1ms轮询         │
 202           *         │     LED_Poll();      // 严格1ms轮询         │
 203           *         │     UpdateLED();     // 充电状态指示更新     │
 204           *         │   }                                         │
 205           *         │   // CPU空闲或做其他任务                     │
 206           *         │ }                                           │
 207           *         └──────────────────────────────�
             -�─────────────┘
 208           * 
 209           * @return 永不返回（嵌入式系统主循环）
 210           */
 211          void main(void)
 212          {
 213   1          Button_Event_t button_event;
 214   1          
 215   1          System_Init();
 216   1          
 217   1          while (1)
 218   1          {
 219   2              switch (Power_GetState())
 220   2              {
 221   3                  case POWER_STATE_OFF:
 222   3                      Power_EnterStopMode();
 223   3                      Power_WakeUpHandler();
 224   3                      
 225   3                      if (Button_GetEvent() != BUTTON_EVENT_NONE || 
 226   3                          Power_GetChargerState() != CHARGER_STATE_NONE)
 227   3                      {
 228   4                          Handle_ButtonEvent(BUTTON_EVENT_LONG_PRESS);
 229   4                          Button_ClearEvent();
 230   4                      }
 231   3                      break;
 232   3                      
 233   3                  case POWER_STATE_ON:
 234   3                      if (s_1ms_flag)
 235   3                      {
 236   4                          s_1ms_flag = 0;
 237   4                          
 238   4                          Button_Poll();
 239   4                          button_event = Button_GetEvent();
C51 COMPILER V7.00  MAIN                                                                   09/29/2026 07:47:58 PAGE 5   

 240   4                          
 241   4                          if (button_event != BUTTON_EVENT_NONE)
 242   4                          {
 243   5                              Handle_ButtonEvent(button_event);
 244   5                              Button_ClearEvent();
 245   5                          }
 246   4                          
 247   4                          Power_Poll();
 248   4                          
 249   4                          if (Power_GetState() == POWER_STATE_ON)
 250   4                          {
 251   5                              Motor_Poll();
 252   5                              LED_Poll();
 253   5                              Update_LED_BasedOnCharger();
 254   5                              
 255   5                              if (Power_GetState() == POWER_STATE_OFF)
 256   5                              {
 257   6                                  LED_SetState(LED_STATE_OFF);
 258   6                                  Motor_Control(0);
 259   6                                  Motor_SetMode(MOTOR_MODE_IDLE);
 260   6                              }
 261   5                          }
 262   4                      }
 263   3                      break;
 264   3                      
 265   3                  default:
 266   3                      break;
 267   3              }
 268   2          }
 269   1      }


