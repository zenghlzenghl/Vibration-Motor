 143          /**
 144           * @brief  根据充电状态更新LED显示
 145           * @note   仅在开机状态下执行
 146           *         优先级：
 147           *         1. BLINK_500MS状态（最高优先级，不可覆盖）
 148           *         2. 充电中→500ms闪烁
 149           *         3. 充满电→常亮
 150           *         4. 无充电器 → 恢复之前状态
 151           */
 152          static void Update_LED_BasedOnCharger(void)
 153          {
 154   1          Charger_State_t charger;
 155   1          LED_State_t led_state;
 156   1          
 157   1          if (Power_GetState() != POWER_STATE_ON)
 158   1          {
 159   2              return;
 160   2          }
 161   1          
 162   1          charger = Power_GetChargerState();
 163   1          led_state = LED_GetState();
 164   1          
 165   1          if (led_state == LED_STATE_BLINK_500MS)
 166   1          {
 167   2              return;
 168   2          }
 169   1          
 170   1          switch (charger)
 171   1          {
 172   2              case CHARGER_STATE_CHARGING:
 173   2                  LED_SetState(LED_STATE_BLINK_CHARGING);
 174   2                  break;
 175   2                  
 176   2              case CHARGER_STATE_FULL:
 177   2                  LED_SetState(LED_STATE_ON);
 178   2                  break;
 179   2                  
C51 COMPILER V7.00  MAIN                                                                   09/29/2026 07:47:58 PAGE 4   

 180   2              default:
 181   2                  if (led_state == LED_STATE_BLINK_CHARGING)
 182   2                  {
 183   3                      LED_SetState(LED_STATE_ON);
 184   3                  }
 185   2                  break;
 186   2          }
 187   1      }
