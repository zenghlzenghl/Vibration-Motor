 328          /**
 329           * @brief  模式7：渐强模式
 330           * @note   占空比从0%逐渐增加到100%，每50ms增加2%
 331           *         达到100%后重置为0%（循环）
 332           *         模拟"呼吸灯"效果的振动感觉
 333           */
 334          void Motor_Mode_Ramp_Up(void)
 335          {
 336   1          if (s_pattern_timer == 0)
 337   1          {
 338   2              if (s_ramp_duty < RAMP_MAX_DUTY)
 339   2              {
 340   3                  s_ramp_duty += RAMP_STEP;
 341   3                  if (s_ramp_duty > RAMP_MAX_DUTY)
 342   3                  {
 343   4                      s_ramp_duty = RAMP_MAX_DUTY;
 344   4                  }
 345   3              }
 346   2              
 347   2              Motor_Control(1);
 348   2              s_pattern_timer = RAMP_UPDATE_INTERVAL_MS;
 349   2              
 350   2              if (s_ramp_duty >= RAMP_MAX_DUTY && s_pattern_timer <= 1)
 351   2              {
 352   3                  s_ramp_duty = 0;
 353   3              }
 354   2          }
 355   1          else
 356   1          {
 357   2              s_pattern_timer--;
 358   2          }
 359   1      }
 360          
 361          /**
 362           * @brief  模式8：渐弱模式
 363           * @note   占空比从100%逐步减少到0%，每50ms减少2%
 364           *         达到0%后重置为100%（循环）
 365           *         与RAMP_UP形成对称效果
C51 COMPILER V7.00  MOTOR                                                                  09/29/2026 07:47:58 PAGE 7   

 366           */
 367          void Motor_Mode_Ramp_Down(void)
 368          {
 369   1          if (s_pattern_timer == 0)
 370   1          {
 371   2              if (s_ramp_duty > 0)
 372   2              {
 373   3                  s_ramp_duty -= RAMP_STEP;
 374   3                  if (s_ramp_duty > RAMP_MAX_DUTY)
 375   3                  {
 376   4                      s_ramp_duty = 0;
 377   4                  }
 378   3              }
 379   2              
 380   2              Motor_Control(s_ramp_duty > 0 ? 1 : 0);
 381   2              s_pattern_timer = RAMP_UPDATE_INTERVAL_MS;
 382   2              
 383   2              if (s_ramp_duty == 0 && s_pattern_timer <= 1)
 384   2              {
 385   3                  s_ramp_duty = RAMP_MAX_DUTY;
 386   3              }
 387   2          }
 388   1          else
 389   1          {
 390   2              s_pattern_timer--;
 391   2          }
 392   1      }
