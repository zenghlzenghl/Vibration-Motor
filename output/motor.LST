 399           *         适合游戏等需要趣味性的场景
 400           */
 401          void Motor_Mode_Random(void)
 402          {
 403   1          u8 random_val;
 404   1          
 405   1          if (s_pattern_timer == 0)
 406   1          {
 407   2              random_val = Get_Random_Byte();
 408   2              
 409   2              if (random_val < 128)
 410   2              {
 411   3                  Motor_Control(1);
 412   3                  s_pattern_timer = RANDOM_VIBRATE_MIN_MS + (random_val % 
 413   3                                  (RANDOM_VIBRATE_MAX_MS - RANDOM_VIBRATE_MIN_MS + 1));
 414   3              }
 415   2              else
 416   2              {
 417   3                  Motor_Control(0);
 418   3                  s_pattern_timer = RANDOM_STOP_MIN_MS + ((random_val - 128) % 
 419   3                                  (RANDOM_STOP_MAX_MS - RANDOM_STOP_MIN_MS + 1));
 420   3              }
 421   2          }
 422   1          else
 423   1          {
 424   2              s_pattern_timer--;
 425   2          }
 426   1      }
