 242          /**
 243           * @brief  检查是否需要自动关机
 244           * @note   私有函数，由Power_Poll()调用
 245           *         条件：
 246           *         - 系统处于ON状态
 247           *         - 无充电器连接
 248           *         - 马达处于IDLE模式
 249           *         - 空闲时间 >= AUTO_POWEROFF_TIME_MS (5分钟)
 250           */
 251          static void Check_AutoPowerOff(void)
 252          {
 253   1          if (s_power_state != POWER_STATE_ON)
 254   1          {
 255   2              return;
 256   2          }
 257   1          
 258   1          if (s_charger_state != CHARGER_STATE_NONE)
 259   1          {
 260   2              return;
 261   2          }
 262   1          
 263   1          if (Motor_GetMode() != MOTOR_MODE_IDLE)
 264   1          {
 265   2              return;
 266   2          }
 267   1          
 268   1          if (s_idle_counter >= AUTO_POWEROFF_TIME_MS)
 269   1          {
 270   2              s_power_state = POWER_STATE_OFF;
 271   2          }
 272   1      }
