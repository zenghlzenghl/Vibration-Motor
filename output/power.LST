 274          /**
 275           * @brief  电源管理轮询函数（非阻塞，需1ms调用一次）
 276           * @note   实现功能：
 277           *         1. 检测充电器插拔事件
 278           *         2. 更新充电状态（充电中/充满）
 279           *         3. 检查是否满足自动关机条件
 280           */
 281          void Power_Poll(void)
 282          {
 283   1          Check_Charger_PlugUnplug();
 284   1          Update_Charging_Status();
 285   1          Check_AutoPowerOff();
 286   1      }


