C51 COMPILER V7.00  POWER                                                                  09/29/2026 07:47:58 PAGE 4   

 180   2              current_p05_state = GPIO_ReadPin(CHARGER_DETECT_PIN);
 181   2              
 182   2              switch (current_p05_state)
 183   2              {
 184   3                  case GPIO_LEVEL_HIGH:
 185   3                      charge_status = GPIO_ReadPin(CHARGE_STATUS_PIN);
 186   3                      
 187   3                      if (charge_status == GPIO_LEVEL_HIGH)
 188   3                      {
 189   4                          s_charger_state = CHARGER_STATE_FULL;
 190   4                      }
 191   3                      else
 192   3                      {
 193   4                          s_charger_state = CHARGER_STATE_CHARGING;
 194   4                      }
 195   3                      
 196   3                      if (s_power_state == POWER_STATE_OFF)
 197   3                      {
 198   4                          s_power_state = POWER_STATE_ON;
 199   4                          s_idle_counter = 0;
 200   4                      }
